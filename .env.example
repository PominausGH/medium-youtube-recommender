# AI Content Curator - Environment Variables
# Copy this file to .env and fill in your values

# Required: OpenAI API Key for GPT-4 summaries
OPENAI_API_KEY=sk-your-api-key-here

# Optional: GitHub token for scanning private repositories
GITHUB_TOKEN=ghp_your-token-here

# Optional: Sentry DSN for error tracking (get from sentry.io)
SENTRY_DSN=https://your-key@sentry.io/project-id

# Optional: Paths for Obsidian and projects
OBSIDIAN_VAULT=/path/to/your/obsidian/vault
PROJECTS_PATH=/path/to/your/projects

# Environment settings
ENVIRONMENT=production
LOG_LEVEL=INFO
APP_VERSION=1.0.0
